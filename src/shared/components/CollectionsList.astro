---
import { getLangFromUrl, useTranslations } from '@shared/i18n/utils';
import { type CollectionMetadata, collectionMetadata, collectionNameMapping } from '@content/config';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="collections bg-polygon relative">
  <div class="relative main-width z-10">
    <h2>
      {t('blog.all-collections')}
    </h2>
    <ul class="badges" role="list">
      {
        collectionMetadata.map((c: CollectionMetadata) => (
          <li class="badge-box" role="listitem">
            <a href={`/${lang}/blog/${c.name}`} class="badge" title={`Blog ${collectionNameMapping(c.name)}`} >
              <img src={c.image} alt={`Logo ${collectionNameMapping(c.name)}`} />
              <span>{ collectionNameMapping(c.name) }</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
.collections {
  background-color: var(--primary);
  h2 {
    -webkit-text-fill-color: white;
  }
}
.badges {
  display: flex;
  flex-wrap: wrap;
  margin: 0 auto;

  .badge-box {
    box-shadow: 0px 1px 2px #00000010;
    margin: 0.3em 0.6em;

    .badge {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      font-size: 20px;
      font-weight: 500;
      color: var(--primary);
      border: dotted 1px var(--white);
      background-color: var(--white);
      padding: .8rem;

      img {
        width: 30px;
        height: 30px;
        object-fit: contain;
        box-shadow: none;
      }
    }
  }

  .badge-box:hover, .badge-box:focus {
    box-shadow: 0px 3px 6px #00000039;

    .badge {
      color: var(--white);
      background-color: var(--alternative);
    }
  }
}
</style>
