---
const gaId = "G-QNMPMXHRJD";
const currentUrl = Astro.url.href;
const isProduction = currentUrl.includes('kevfiorentino.com');

if (!isProduction || !gaId) {
  return;
}
---

<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>

<script define:vars={{ gaId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    window.dataLayer.push(arguments);
  }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', gaId, {
    anonymize_ip: true
  });
</script>
