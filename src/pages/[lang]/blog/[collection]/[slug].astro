---
import { getCollection } from 'astro:content';
import { collectionMetadata } from '@content/config';
import MainLayout from '@shared/layouts/MainLayout.astro';
import Breadcrumbs from '@shared/components/articles/Breadcrumbs.astro';
import ToC from '@shared/components/articles/ToC.astro';
import PrevNext from '@shared/components/articles/PrevNext.astro';

import '@shared/styles/article.scss';

export async function getStaticPaths() {

  const pages: any[] = [];

  // Build pages of each content
  for await (let c of collectionMetadata) {
    const coll = await getCollection(c.name);
    for (const post of coll) {
      pages.push({
        params: {
          lang: 'es',
          collection: c.name,
          slug: post.slug,
        },
        props: {
          post: post,
          isEnglishAvailable: true, // Spanish is always available
        },
      });
      // Always generate English route
      let enPost: any = post as any; // Default to Spanish post
      let isEnglishAvailable = false;
      if (post.data.englishMetadata?.hasEnglishVersion) {
        if (c.name === 'blockchain') {
          const enColl = await getCollection('blockchain-en');
          const found = enColl.find(p => p.slug === post.slug);
          if (found) {
            enPost = found;
            isEnglishAvailable = true;
          }
        } else if (c.name === 'solana') {
          const enColl = await getCollection('solana-en');
          const found = enColl.find(p => p.slug === post.slug);
          if (found) {
            enPost = found;
            isEnglishAvailable = true;
          }
        }
      }
      pages.push({
        params: {
          lang: 'en',
          collection: c.name,
          slug: post.slug,
        },
        props: {
          post: enPost,
          isEnglishAvailable,
        },
      });
    }
  }

  return pages;
}

const param = Astro.params;
const { post, isEnglishAvailable } = Astro.props;

const { collection } = post;
const { title, description, pubDate, englishMetadata, prev, next } = post.data;

let displayTitle = title;
let displayDescription = description;

if (param.lang === 'en') {
  if (isEnglishAvailable) {
    // Use English title and description from the English post
    displayTitle = title;
    displayDescription = description;
  } else {
    // Use English metadata from Spanish post
    displayTitle = englishMetadata?.title || title;
    displayDescription = englishMetadata?.description || description;
  }
}

const { Content, headings } = await post.render();
---

<MainLayout
  title={`${displayTitle} | Kevin Fiorentino`}
  description={displayDescription}
  image='/kevin2025.jpg'
  addWidth={true}
>
  <section class="grid grid-cols-5">
    <section class="col-span-5 md:col-span-3 sm:col-span-5 xs:col-span-5">
      <section class="header-article-content">
        <Breadcrumbs
          collection={collection}
          pubDate={pubDate}
        ></Breadcrumbs>
      </section>
      <article class="main-article-content">
        {param.lang === 'en' && !isEnglishAvailable ? (
          <>
            <h1>{displayTitle}</h1>
            <div class="no-english-version">
              <p>Sorry, this article is not available in English. You can <a href={`/es/blog/${collection}/${post.slug}`} class="btn">read the Spanish version</a>.</p>
              <small class="fill-black dark:fill-white">(if you don't know Spanish, I recommend using any AI translator 😊)</small>
            </div>
          </>
        ) : (
          <Content />
        )}
      </article>
      <PrevNext
        collection={collection}
        prev={prev}
        next={next}
      ></PrevNext>
    </section>
    <aside class="md:col-span-2 hidden md:inline mx-5">
      <ToC headings={headings}></ToC>
    </aside>
  </section>
</MainLayout>
